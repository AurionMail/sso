{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["es2020", "dom"],
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "typeRoots": ["./typings", "./node_modules/@types"],
    "esModuleInterop": true
  },
  "exclude": ["contrib"]
}