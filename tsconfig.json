{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom"],
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "src/client/env.d.ts"],
  "exclude": ["node_modules", "dist", "lib"]
}