extends layout

block content
  div(class="w-full max-w-md bg-slate-800 border border-slate-700/80 rounded-2xl shadow-2xl p-8 backdrop-blur-sm")
    // En-tête du formulaire
    div(class="text-center mb-8")
      div(class="inline-flex items-center justify-center w-12 h-12 bg-sky-500/10 text-sky-400 rounded-xl mb-3 border border-sky-500/20")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z")
      h1(id="login-title" class="text-2xl font-bold text-white tracking-wide") Connexion SSO
      p(class="text-sm text-slate-400 mt-1") Authentification sécurisée Aurion


    if error
      div(class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center space-x-3")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor")
          path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd")
        span= error

    // Formulaire de connexion
    form(id="login-form" action=action method="POST" class="space-y-5")
      input(type="hidden" name="_csrf" value=csrfToken)
      input(type="hidden" name="challenge" value=challenge)

      // Champ Identifiant / Email
      div
        label(for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2") Nom d'utilisateur ou Email
        input(
          type="text" 
          id="email" 
          name="email" 
          value=hint 
          required 
          autocomplete="username"
          placeholder="nom@domaine.fr"
          class="w-full px-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all text-sm"
        )

      // Champ Mot de passe
      div
        label(for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2") Mot de passe
        input(
          type="password" 
          id="password" 
          name="password" 
          required 
          autocomplete="current-password"
          placeholder="••••••••••••"
          class="w-full px-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all text-sm"
        )

      // Se souvenir de moi
      div(class="flex items-center justify-between pt-1")
        label(class="flex items-center space-x-2.5 cursor-pointer")
          input(
            type="checkbox" 
            id="remember" 
            name="remember" 
            value="1" 
            class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-sky-500 focus:ring-sky-500/20 focus:ring-offset-0 cursor-pointer"
          )
          span(class="text-xs text-slate-300 font-medium") Se souvenir de moi

      // Actions (Validation & Refus)
      div(class="pt-2 space-y-3")
        button(
          type="submit" 
          id="accept" 
          name="btn_submit" 
          value="Log in"
          class="w-full py-3 px-4 bg-sky-500 hover:bg-sky-600 active:bg-sky-700 text-white font-medium rounded-xl shadow-lg shadow-sky-500/20 transition-all text-sm flex items-center justify-center space-x-2 cursor-pointer"
        )
          span(id="btn-text") Se connecter

        button(
          type="submit" 
          id="reject" 
          name="btn_submit" 
          value="Deny access"
          formnovalidate
          class="w-full py-2.5 px-4 bg-transparent hover:bg-slate-700/50 text-slate-400 hover:text-slate-200 font-medium rounded-xl border border-slate-700/50 transition-all text-xs cursor-pointer"
        ) Refuser l'accès

  // Script d'interception et de dérivation Argon2id
  script.
    const form = document.getElementById('login-form');
    const acceptBtn = document.getElementById('accept');
    const btnText = document.getElementById('btn-text');

    form.addEventListener('submit', async (e) => {
      // Si l'utilisateur clique sur "Refuser l'accès", on ne dérive pas le mot de passe
      if (e.submitter && e.submitter.id === 'reject') {
        return;
      }

      e.preventDefault();

      // Indication visuelle de traitement
      acceptBtn.disabled = true;
      btnText.textContent = 'Calcul de la clé sécurisée...';

      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      
      const username = emailInput.value.trim();
      const rawPassword = passwordInput.value;

      try {
        // Dérivation Argon2id (Secret A transmis pour validation LDAP / Hydra)
        const salt = new TextEncoder().encode(`auth_salt_${username}`);
        const derivedHash = await hashwasm.argon2id({
          password: rawPassword,
          salt: salt,
          parallelism: 1,
          iterations: 3,
          memorySize: 65536, // 64 MB
          hashLength: 32,
          outputType: 'hex',
        });

        // Substitution du mot de passe brut par la valeur dérivée
        passwordInput.value = derivedHash;

        // Soumission finale du formulaire vers le serveur Node.js
        HTMLFormElement.prototype.submit.call(form);
      } catch (err) {
        console.error('Erreur lors de la dérivation Argon2id:', err);
        btnText.textContent = 'Erreur de dérivation';
        acceptBtn.disabled = false;
      }
    });