extends layout

block content
  div(class="rounded-2xl border border-border/60 bg-background/80 backdrop-blur-sm shadow-xl shadow-black/5 dark:shadow-black/20 overflow-hidden w-full max-w-md")
    div(class="px-8 pt-10 pb-6 text-center")
      div(class="inline-flex items-center justify-center mb-5 w-16 h-16 rounded-2xl bg-primary/10 text-primary border border-primary/20 shadow-sm")
        svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock w-8 h-8" aria-hidden="true")
          rect(width="18" height="11" x="3" y="11" rx="2" ry="2")
          path(d="M7 11V7a5 5 0 0 1 10 0v4")
      h1(id="login-title" class="text-2xl font-semibold text-foreground tracking-tight")= t('login.title')
      p(class="text-sm text-muted-foreground mt-1.5")= t('login.subtitle')

    div(class="px-8 pb-8")
      if error
        div(class="mb-5 p-3 rounded-xl border border-destructive/20 bg-destructive/5 flex items-start gap-3" role="alert" aria-live="polite")
          div(class="w-10 h-10 rounded-full bg-destructive/15 text-destructive flex items-center justify-center flex-shrink-0 shadow-sm")
            svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert w-5 h-5" aria-hidden="true")
              circle(cx="12" cy="12" r="10")
              line(x1="12" x2="12" y1="8" y2="12")
              line(x1="12" x2="12.01" y1="16" y2="16")
          div(class="flex-1 min-w-0 self-center flex items-center gap-2")
            p(class="text-sm text-destructive flex-1 leading-relaxed")= error

      div(id="error-banner" class=`${error ? '' : 'hidden '}mb-5 p-3 rounded-xl border border-destructive/20 bg-destructive/5 flex items-start gap-3` role="alert" aria-live="polite")
        div(class="w-10 h-10 rounded-full bg-destructive/15 text-destructive flex items-center justify-center flex-shrink-0 shadow-sm")
          svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert w-5 h-5" aria-hidden="true")
            circle(cx="12" cy="12" r="10")
            line(x1="12" x2="12" y1="8" y2="12")
            line(x1="12" x2="12.01" y1="16" y2="16")
        div(class="flex-1 min-w-0 self-center flex items-center gap-2")
          p(id="error-message" class="text-sm text-destructive flex-1 leading-relaxed")= error

      form(id="login-form" action=action method="POST" class="space-y-5")
        input(type="hidden" name="_csrf" value=csrfToken)
        input(type="hidden" name="challenge" value=challenge)
        input(type="hidden" name="secret" id="secret")
        input(type="hidden" name="secretId" id="secretId")
        input(type="hidden" name="loginToken" id="loginToken")

        input(type="hidden" name="opaqueSessionId" id="opaqueSessionId")
        input(type="hidden" name="opaqueKe3" id="opaqueKe3")

        fieldset(class="space-y-4")
          div(class="space-y-1.5")
            label(for="username" class="block text-sm font-medium text-foreground")= t('login.username')
            div(class="relative")
              input(
                type="text"
                id="username"
                name="username"
                value=hint
                required
                autocomplete="username"
                class="flex w-full border py-2 text-sm text-foreground file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 h-11 px-3.5 bg-muted/40 border-border/60 rounded-xl focus:bg-background focus:border-primary/50 transition-all duration-200"
              )

          div(class="space-y-1.5")
            label(for="password" class="block text-sm font-medium text-foreground")= t('login.password')
            div(class="relative")
              input(
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                class="flex w-full border py-2 text-sm text-foreground file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 h-11 px-3.5 bg-muted/40 border-border/60 rounded-xl focus:bg-background focus:border-primary/50 transition-all duration-200"
              )

          label(class="flex items-center gap-2.5 cursor-pointer group select-none pt-1")
            span(class="relative flex items-center justify-center")
              input(
                type="checkbox"
                id="remember"
                name="remember"
                value="1"
                class="peer sr-only"
              )
              span(class="flex items-center justify-center w-4.5 h-4.5 rounded-[5px] border border-border/80 bg-muted/40 peer-checked:bg-primary peer-checked:border-primary peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-background transition-all duration-200")
            span(class="text-sm text-muted-foreground group-hover:text-foreground transition-colors")= t('login.rememberMe')

        div(class="space-y-3 pt-1")
          button(
            type="submit"
            id="accept"
            name="btn_submit"
            value="Log in"
            class="inline-flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 text-primary-foreground px-4 py-2 w-full h-11 font-medium text-[15px] bg-primary hover:bg-primary/90 transition-all duration-200 rounded-xl shadow-md shadow-primary/15 hover:shadow-lg hover:shadow-primary/20 cursor-pointer"
          )
            div(class="flex items-center gap-2")
              svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-in w-4 h-4" aria-hidden="true")
                path(d="m10 17 5-5-5-5")
                path(d="M15 12H3")
                path(d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4")
              span(id="btn-text")= t('login.submit')

          button(
            type="submit"
            id="reject"
            name="btn_submit"
            value="Deny access"
            formnovalidate
            class="inline-flex items-center justify-center w-full h-10 px-4 text-xs font-medium text-muted-foreground hover:text-foreground bg-transparent hover:bg-muted/50 rounded-xl transition-colors duration-200 cursor-pointer"
          )= t('login.denyAccess')

  script(type="module").
    import * as opaque from '/public/js/opaque.bundle.js';

    const form = document.getElementById('login-form');
    const acceptBtn = document.getElementById('accept');
    const btnText = document.getElementById('btn-text');
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');

    const WEBMAIL_DOMAIN_WP = !{JSON.stringify(webmailDomain)};
    const ENCRYPTION_ALGO = 'AES-GCM';
    const HKDF_SALT = new Uint8Array(16);

    function bufferToHex(buffer) {
      return Array.from(new Uint8Array(buffer))
        .map(b => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function deriveKeyFromSeed(seedBytes) {
      const hkdfMasterKey = await window.crypto.subtle.importKey(
        'raw',
        seedBytes,
        'HKDF',
        false,
        ['deriveKey']
      );

      return await window.crypto.subtle.deriveKey(
        {
          name: 'HKDF',
          hash: 'SHA-256',
          salt: HKDF_SALT,
          info: new TextEncoder().encode('AURION-0K-SECRET-V1')
        },
        hkdfMasterKey,
        { name: ENCRYPTION_ALGO, length: 256 },
        false,
        ['encrypt', 'decrypt']
      );
    }

    async function processSecret(secretValue) {
      const seed = window.crypto.getRandomValues(new Uint8Array(32));
      const iv = window.crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveKeyFromSeed(seed);
      const encodedSecret = new TextEncoder().encode(secretValue);
      
      const ciphertextBuffer = await window.crypto.subtle.encrypt(
        { name: 'AES-GCM', iv },
        key,
        encodedSecret
      );

      return {
        ciphertextHex: bufferToHex(ciphertextBuffer),
        ivHex: bufferToHex(iv),
        seedHex: bufferToHex(seed)
      };
    }
    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
      acceptBtn.disabled = false;
      btnText.textContent = "#{t('login.submit')}";
    }

    form.addEventListener('submit', async (e) => {
      if (e.submitter && e.submitter.id === 'reject') {
        return;
      }

      e.preventDefault();

      acceptBtn.disabled = true;
      btnText.textContent = "#{t('login.progress')}";

      const emailInput = document.getElementById('username');
      const passwordInput = document.getElementById('password');
      const secretIdInput = document.getElementById('secretId');
      const secretInput = document.getElementById('secret');
      const loginTokenInput = document.getElementById('loginToken');
      
      const opaqueSessionIdInput = document.getElementById('opaqueSessionId');
      const opaqueKe3Input = document.getElementById('opaqueKe3');

      const username = emailInput.value.trim();
      const rawPassword = passwordInput.value;

      try {
         const salt = new TextEncoder().encode(`auth_salt_${username}`);
         // this salt is deterministic because it is only used for domain separation. True security comes from the OPAQUE protocol.
          const password  = await hashwasm.argon2id({
            password: rawPassword,
            salt: salt,
            parallelism: 1,
            iterations: 3,
            memorySize: 65536,
            hashLength: 32,
            outputType: 'hex',
          });
        const { startLoginRequest, clientLoginState } = opaque.client.startLogin({
          password
        });

        const challengeResponse = await fetch(`/login/opaque/init`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            username, 
            startLoginRequest 
          })
        });

        if (!challengeResponse.ok) {
          throw new Error('Error when asking for an opaque challenge from the server');
        }

        const { sessionId, loginResponse } = await challengeResponse.json();

        const { finishLoginRequest, sessionKey } = opaque.client.finishLogin({
          clientLoginState,
          loginResponse,
          password
        });
        if(!sessionKey){
          showError("#{t('login.invalidCredentials')}");
          return;
        }

        const { ciphertextHex, ivHex, seedHex } = await processSecret(rawPassword);
        const id = crypto.randomUUID();

        const login_token = crypto.randomUUID();

        const iframe = document.createElement('iframe');
        iframe.src = WEBMAIL_DOMAIN_WP + '/bridge-minimal.html';
        iframe.style.display = 'none';
        document.body.appendChild(iframe);

        iframe.onload = () => {
          iframe.contentWindow?.postMessage(
            {
              type: 'WRITE_SECRET',
              secret: { id, seed: seedHex, iv: ivHex },
              login_token: login_token
            },
            WEBMAIL_DOMAIN_WP
          );
        };

        const handleBridgeConfirmation = (event) => {
          if (event.origin !== WEBMAIL_DOMAIN_WP) return;
          if (event.data && event.data.type === 'WRITE_SUCCESS') {
            window.removeEventListener('message', handleBridgeConfirmation);
            document.body.removeChild(iframe);

            passwordInput.value = '';
            secretInput.value = ciphertextHex;
            secretIdInput.value = id;
            loginTokenInput.value = login_token;
            
            opaqueSessionIdInput.value = sessionId;
            opaqueKe3Input.value = finishLoginRequest;

            HTMLFormElement.prototype.submit.call(form);
          }
        };

        window.addEventListener('message', handleBridgeConfirmation);

      } catch (err) {
        console.error('Error OPAQUE / Bridge :', err);
        showError("#{t('login.invalidCredentials')}");
        btnText.textContent = "#{t('login.submit')}";
      }
    });