extends layout

block content
  div(class="rounded-2xl border border-border/60 bg-background/80 backdrop-blur-sm shadow-xl shadow-black/5 dark:shadow-black/20 overflow-hidden w-full max-w-md")
    // En-tête de la fenêtre
    div(class="px-8 pt-10 pb-6 text-center")
      if client.logo_uri
        div(class="mb-5 inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-muted/50 border border-border/60 shadow-sm overflow-hidden p-2")
          img(src=client.logo_uri, alt=client.client_name || client.client_id, class="max-w-full max-h-full object-contain")
      else
        div(class="inline-flex items-center justify-center mb-5 w-16 h-16 rounded-2xl bg-primary/10 text-primary border border-primary/20 shadow-sm")
          svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-8 h-8" aria-hidden="true")
            path(d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z")
            path(d="m9 12 2 2 4-4")

      h1(id="consent-title" class="text-2xl font-semibold text-foreground tracking-tight") Demande d'autorisation
      p(class="text-sm text-muted-foreground mt-1.5")
        | Une application souhaite accéder à vos données

    div(class="px-8 pb-8")
      // Message de confirmation / informations client
      div(class="mb-6 p-4 rounded-xl border border-border/60 bg-muted/30 text-sm text-foreground/90 leading-relaxed")
        p Bonjour #[strong.font-semibold.text-foreground #{user}], l'application #[strong.font-semibold.text-primary #{client.client_name || client.client_id}] souhaite accéder à vos ressources en votre nom pour :

      // Formulaire d'autorisation
      form(id="consent-form" action=action method="POST" class="space-y-6")
        input(type="hidden" name="challenge" value=challenge)
        input(type="hidden" name="_csrf" value=csrfToken)

        // Liste des permissions (Scopes)
        fieldset(class="space-y-3")
          legend(class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2 block") Permissions demandées
          
          each scope in requested_scope
            label(class="flex items-start gap-3 p-3 rounded-xl border border-border/50 bg-muted/20 hover:bg-muted/40 transition-colors cursor-pointer group select-none")
              span(class="relative flex items-center justify-center pt-0.5")
                input(
                  type="checkbox"
                  id=scope
                  name="grant_scope"
                  value=scope
                  checked
                  class="peer sr-only grant_scope"
                )
                span(class="flex items-center justify-center w-[18px] h-[18px] rounded-[5px] border border-border/80 bg-background peer-checked:bg-primary peer-checked:border-primary peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-background transition-all duration-200")
                  svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity")
                    polyline(points="20 6 9 17 4 12")
              div(class="flex-1 min-w-0")
                span(class="text-sm font-medium text-foreground block group-hover:text-primary transition-colors") #{scope}

        // Option "Ne plus me demander"
        div(class="pt-2 border-t border-border/40 space-y-3")
          label(class="flex items-center gap-2.5 cursor-pointer group select-none")
            span(class="relative flex items-center justify-center")
              input(
                type="checkbox"
                id="remember"
                name="remember"
                value="1"
                class="peer sr-only"
              )
              span(class="flex items-center justify-center w-[18px] h-[18px] rounded-[5px] border border-border/80 bg-muted/40 peer-checked:bg-primary peer-checked:border-primary peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-background transition-all duration-200")
                svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity")
                  polyline(points="20 6 9 17 4 12")
            span(class="text-sm text-muted-foreground group-hover:text-foreground transition-colors") Ne plus me demander à l'avenir

          p(class="text-xs text-muted-foreground/80 leading-normal pl-7")
            | L'application ne pourra pas demander de nouvelles autorisations sans votre consentement.

        // Liens d'information client (Politique & CGU)
        if client.policy_uri || client.tos_uri
          div(class="flex items-center justify-center gap-4 pt-1 text-xs text-muted-foreground")
            if client.policy_uri
              a(href=client.policy_uri target="_blank" rel="noopener noreferrer" class="hover:text-foreground hover:underline transition-colors") Politique de confidentialité
            if client.policy_uri && client.tos_uri
              span(class="text-border") •
            if client.tos_uri
              a(href=client.tos_uri target="_blank" rel="noopener noreferrer" class="hover:text-foreground hover:underline transition-colors") Conditions d'utilisation

        // Boutons d'action (Autoriser & Refuser)
        div(class="space-y-3 pt-2")
          button(
            type="submit"
            id="accept"
            name="submit"
            value="Allow access"
            class="inline-flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 text-primary-foreground px-4 py-2 w-full h-11 font-medium text-[15px] bg-primary hover:bg-primary/90 transition-all duration-200 rounded-xl shadow-md shadow-primary/15 hover:shadow-lg hover:shadow-primary/20 cursor-pointer"
          )
            div(class="flex items-center gap-2")
              svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-4 h-4" aria-hidden="true")
                polyline(points="20 6 9 17 4 12")
              span Autoriser l'accès

          button(
            type="submit"
            id="reject"
            name="submit"
            value="Deny access"
            formnovalidate
            class="inline-flex items-center justify-center w-full h-10 px-4 text-xs font-medium text-muted-foreground hover:text-foreground bg-transparent hover:bg-muted/50 rounded-xl transition-colors duration-200 cursor-pointer"
          ) Refuser l'accès