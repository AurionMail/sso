extends layout

block content
  div(class="rounded-2xl border border-border/60 bg-background/80 backdrop-blur-sm shadow-xl shadow-black/5 dark:shadow-black/20 overflow-hidden w-full max-w-md")
    div(class="px-8 pt-10 pb-6 text-center")
      div(class="inline-flex items-center justify-center mb-5 w-16 h-16 rounded-2xl bg-primary/10 text-primary border border-primary/20 shadow-sm")
        svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round w-8 h-8" aria-hidden="true")
          path(d="M2 18v3c0 .6.4 1 1 1h4v-3h3v-3h2l1.4-1.4a6.5 6.5 0 1 0-4-4Z")
          circle(cx="16.5" cy="7.5" r=".5" fill="currentColor")
      h1(id="init-title" class="text-2xl font-semibold text-foreground tracking-tight")= t('init.title')
      p(class="text-sm text-muted-foreground mt-1.5")= t('init.subtitle')

    div(class="px-8 pb-8")
      div(id="error-banner" class=`${error ? '' : 'hidden '}mb-5 p-3 rounded-xl border border-destructive/20 bg-destructive/5 flex items-start gap-3` role="alert" aria-live="polite")
        div(class="w-10 h-10 rounded-full bg-destructive/15 text-destructive flex items-center justify-center flex-shrink-0 shadow-sm")
          svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert w-5 h-5" aria-hidden="true")
            circle(cx="12" cy="12" r="10")
            line(x1="12" x2="12" y1="8" y2="12")
            line(x1="12" x2="12.01" y1="16" y2="16")
        div(class="flex-1 min-w-0 self-center flex items-center gap-2")
          p(id="error-message" class="text-sm text-destructive flex-1 leading-relaxed")= error

      form(id="init-form" action=action method="POST" class="space-y-4")
        input(type="hidden" name="_csrf" value=csrfToken)
        if isPreFilled
          input(type="hidden" name="isPreFilled" value="true")
        if challenge
          input(type="hidden" name="challenge" value=challenge)

        input(type="hidden" name="srpSalt" id="srpSalt")
        input(type="hidden" name="srpVerifier" id="srpVerifier")

        fieldset(class="space-y-4")
          div(class="space-y-1.5")
            label(for="username" class="block text-sm font-medium text-foreground")= t('init.username')
            div(class="relative")
              if isPreFilled
                input(
                  type="text"
                  id="username"
                  value=hint
                  readonly
                  tabindex="-1"
                  class="flex w-full border py-2 text-sm text-foreground opacity-70 cursor-not-allowed select-none h-11 px-3.5 bg-muted/60 border-border/60 rounded-xl focus:outline-none"
                )
                input(type="hidden" name="username" value=hint)
              else
                input(
                  type="text"
                  id="username"
                  name="username"
                  value=hint
                  required
                  autocomplete="username"
                  placeholder=t('init.username')
                  class="flex w-full border py-2 text-sm text-foreground file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 h-11 px-3.5 bg-muted/40 border-border/60 rounded-xl focus:bg-background focus:border-primary/50 transition-all duration-200"
                )

          if isPreFilled
            input(type="hidden" id="tempPassword" name="tempPassword" value=tempPassword)
          else
            div(class="space-y-1.5")
              label(for="tempPassword" class="block text-sm font-medium text-foreground")= t('init.tempPassword')
              div(class="relative")
                input(
                  type="password"
                  id="tempPassword"
                  name="tempPassword"
                  value=tempPassword
                  required
                  autocomplete="current-password"
                  class="flex w-full border py-2 text-sm text-foreground file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 h-11 px-3.5 bg-muted/40 border-border/60 rounded-xl focus:bg-background focus:border-primary/50 transition-all duration-200"
                )

          div(class="space-y-1.5")
            label(for="newPassword" class="block text-sm font-medium text-foreground")= t('init.newPassword')
            div(class="relative")
              input(
                type="password"
                id="newPassword"
                name="newPassword"
                required
                autocomplete="new-password"
                class="flex w-full border py-2 text-sm text-foreground file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 h-11 px-3.5 bg-muted/40 border-border/60 rounded-xl focus:bg-background focus:border-primary/50 transition-all duration-200"
              )

          div(class="space-y-1.5")
            label(for="confirmPassword" class="block text-sm font-medium text-foreground")= t('init.confirmPassword')
            div(class="relative")
              input(
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                autocomplete="new-password"
                class="flex w-full border py-2 text-sm text-foreground file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 h-11 px-3.5 bg-muted/40 border-border/60 rounded-xl focus:bg-background focus:border-primary/50 transition-all duration-200"
              )

        div(class="space-y-3 pt-3")
          button(
            type="submit"
            id="accept"
            name="btn_submit"
            value="Initialize"
            class="inline-flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 text-primary-foreground px-4 py-2 w-full h-11 font-medium text-[15px] bg-primary hover:bg-primary/90 transition-all duration-200 rounded-xl shadow-md shadow-primary/15 hover:shadow-lg hover:shadow-primary/20 cursor-pointer"
          )
            div(class="flex items-center gap-2")
              svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle w-4 h-4" aria-hidden="true")
                path(d="M22 11.08V12a10 10 0 1 1-5.93-9.14")
                polyline(points="22 4 12 14.01 9 11.01")
              span(id="btn-text")= t('init.submit')
  script(src="/vendor/crypto-js/crypto-js.js")
  script(type="module").
    const rfc5054 = {
      N_base10: "",
      g_base10: "2",
      k_base16: "5b9e8ef059c6b32ea59fc1d322d37f04aa30bae5aa9003b8321e21ddb04e300"
    };

    const clientModule = await import("/vendor/thinbus-srp/client.mjs");
    const SRP6JavascriptClientSession = clientModule.default(
      rfc5054.N_base10,
      rfc5054.g_base10,
      rfc5054.k_base16
    );

    const i18n = {
      submit: "!{t('init.submit')}",
      progress: "!{t('init.progress')}",
      mismatch: "!{t('init.errors.mismatch')}",
      samePassword: "!{t('init.errors.samePassword')}",
      crypto: "!{t('init.errors.crypto')}"
    };

    const form = document.getElementById('init-form');
    const acceptBtn = document.getElementById('accept');
    const btnText = document.getElementById('btn-text');
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');

    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
      acceptBtn.disabled = false;
      btnText.textContent = i18n.submit;
    }

    function bufferToHex(buffer) {
      return Array.from(new Uint8Array(buffer))
        .map(b => b.toString(16).padStart(2, '0'))
        .join('');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const usernameInput = document.getElementById('username');
      const tempPasswordInput = document.getElementById('tempPassword');
      const newPasswordInput = document.getElementById('newPassword');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const srpSaltInput = document.getElementById('srpSalt');
      const srpVerifierInput = document.getElementById('srpVerifier');

      const username = usernameInput.value.trim().toLowerCase();
      const rawTempPassword = tempPasswordInput.value;
      const rawNewPassword = newPasswordInput.value;
      const rawConfirmPassword = confirmPasswordInput.value;
      if (!username || !rawTempPassword || !rawNewPassword) {
        return;
      }

      if (rawNewPassword !== rawConfirmPassword) {
        showError(i18n.mismatch);
        return;
      }

      if (rawTempPassword === rawNewPassword) {
        showError(i18n.samePassword);
        return;
      }

      acceptBtn.disabled = true;
      btnText.textContent = i18n.progress;

      try {
        const srpClient = new SRP6JavascriptClientSession();
        const saltBytes = window.crypto.getRandomValues(new Uint8Array(16));
        const saltHex = bufferToHex(saltBytes);

        const verifierHex = srpClient.generateVerifier(saltHex, username, rawNewPassword);// TODO USE has

        srpSaltInput.value = saltHex;
        srpVerifierInput.value = verifierHex;

        newPasswordInput.value = '';
        confirmPasswordInput.value = '';

        form.submit();

      } catch (err) {
        console.error('Error when calculating SRP :', err);
        showError(i18n.crypto);
      }
    });