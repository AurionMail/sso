{
  "name": "hydra-login-consent-logout",
  "version": "2.4.0-pre.3",
  "bin": {
    "hydra-login-consent-logout": "lib/app.js"
  },
  "files": [
    "lib",
    "views"
  ],
  "scripts": {
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "build": "npm run build:css && tsc",
    "dev": "concurrently \"npm run watch:css\" \"tsx watch --clear-screen=false src/app.ts\"",
    "serve": "node --env-file=.env lib/app.js"
  },
  "prettier": "ory-prettier-styles",
  "dependencies": {
    "@ory/hydra-client-fetch": "^2.4.0-alpha.1",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "express": "^4.21.2",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "ldapts": "^9.0.0",
    "morgan": "^1.10.0",
    "pug": "^3.0.3",
    "thinbus-srp": "^2.0.2",
    "url-join": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.9.36",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/url-join": "^4.0.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "ory-prettier-styles": "1.3.0",
    "postcss": "^8.5.23",
    "prettier": "^2.7.1",
    "prettier-plugin-packagejson": "^2.2.18",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
